# QuantAI Backend API Test Configuration

# =============================================================================
# Backend API Settings
# =============================================================================
BASE_URL=http://localhost:8000

# Test User Credentials (create a test user first)
TEST_USERNAME=testuser@quantai.in
TEST_PASSWORD=TestPass123!

# =============================================================================
# Upstox Reference API (for price validation)
# =============================================================================
# Get this from Upstox developer console after OAuth
UPSTOX_ACCESS_TOKEN=your_upstox_access_token_here

# =============================================================================
# Database (for DB consistency tests)
# =============================================================================
DATABASE_URL=postgresql://postgres:admin@localhost:5432/quantai

# =============================================================================
# Test Settings
# =============================================================================
# Price tolerance thresholds (as decimal, e.g., 0.001 = 0.1%)
PRICE_TOLERANCE_LTP=0.001
PRICE_TOLERANCE_OHLC=0.002

# Maximum age for data to be considered fresh (in minutes)
STALE_THRESHOLD_MINUTES=5

# Number of test symbols to use (default: 25)
TEST_SYMBOL_COUNT=25

# Enable/disable slow tests
RUN_SLOW_TESTS=false

# Parallel workers for pytest-xdist
PYTEST_WORKERS=4
