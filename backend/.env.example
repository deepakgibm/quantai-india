# QuantAI Environment Configuration Template
# -----------------------------------------
# Copy this file to .env and fill in your actual values
# NEVER commit .env with real secrets to version control!

# ===== DATABASE =====
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/quantai

# ===== SECURITY =====
# Generate a secure random key: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=REPLACE_WITH_SECURE_RANDOM_KEY_64_CHARS_MINIMUM

# ===== FIREBASE (Optional - for Google Auth) =====
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENTID=G-XXXXXXXXXX

# ===== UPSTOX API =====
# Get these from https://developer.upstox.com/
UPSTOX_API_KEY=your_upstox_api_key
UPSTOX_API_SECRET=your_upstox_api_secret
UPSTOX_REDIRECT_URI=http://localhost:3000/callback
# Access token is obtained via OAuth flow - do not hardcode!
UPSTOX_ACCESS_TOKEN=

# ===== GEMINI AI =====
# Get this from https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key

# ===== TRADING CONFIGURATION =====
MAX_CAPITAL_PER_TRADE=100000
MAX_RISK_PERCENTAGE=2.0

# ===== CACHE CONFIGURATION =====
DRAGONFLY_HOST=localhost
DRAGONFLY_PORT=6379
