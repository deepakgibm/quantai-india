                                "exec": [
                                    "pm.test('Status code is 200', function() {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "",
                                    "pm.test('Health status is healthy', function() {",
                                    "    const resp = pm.response.json();",
                                    "    pm.expect(resp.status).to.equal('healthy');",
