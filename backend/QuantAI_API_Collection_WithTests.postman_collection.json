        {
            "name": "Stock Price APIs",
            "description": "Stock price endpoints for validation against external sources",
            "item": [
                {
                    "name": "NIFTY 100 Top Movers",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Status code is 200', function() {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "",
                                    "pm.test('Response has gainers array', function() {",
                                    "    const resp = pm.response.json();",
                                    "    pm.expect(resp).to.have.property('gainers');",
                                    "    pm.expect(resp.gainers).to.be.an('array');",
                                    "});",
                                    "",
                                    "pm.test('Response has losers array', function() {",
                                    "    const resp = pm.response.json();",
                                    "    pm.expect(resp).to.have.property('losers');",
                                    "    pm.expect(resp.losers).to.be.an('array');",
                                    "});",
                                    "",
                                    "pm.test('Stock entries have required fields', function() {",
                                    "    const resp = pm.response.json();",
                                    "    const allStocks = [...(resp.gainers || []), ...(resp.losers || [])];",
                                    "    if (allStocks.length > 0) {",
                                    "        const stock = allStocks[0];",
                                    "        pm.expect(stock).to.have.property('symbol');",
                                    "        pm.expect(stock).to.have.property('ltp');",
                                    "        pm.expect(stock.ltp).to.be.a('number');",
                                    "        pm.expect(stock.ltp).to.be.above(0);",
                                    "    }",
                                    "});",
                                    "",
                                    "// Store prices for validation",
                                    "const resp = pm.response.json();",
                                    "const prices = {};",
                                    "[...(resp.gainers || []), ...(resp.losers || [])].forEach(s => {",
                                    "    if (s.symbol && s.ltp) prices[s.symbol] = s.ltp;",
                                    "});",
                                    "pm.collectionVariables.set('extractedPrices', JSON.stringify(prices));",
                                    "console.log('Extracted prices for', Object.keys(prices).length, 'symbols');"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "url": "{{baseUrl}}/api/market/nifty100/top-movers"
                    }
                },
                {
