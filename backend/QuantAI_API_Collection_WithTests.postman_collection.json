                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Status code is 200 or 404', function() {",
                                    "    pm.expect(pm.response.code).to.be.oneOf([200, 404]);",
                                    "});",
                                    "",
                                    "if (pm.response.code === 200) {",
                                    "    pm.test('Response has symbol field', function() {",
                                    "        const resp = pm.response.json();",
                                    "        pm.expect(resp).to.have.property('symbol');",
                                    "        pm.expect(resp.symbol).to.equal('RELIANCE');",
                                    "    });",
                                    "    ",
                                    "    pm.test('Response has data object', function() {",
                                    "        const resp = pm.response.json();",
                                    "        pm.expect(resp).to.have.property('data');",
                                    "    });",
                                    "}"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "url": "{{baseUrl}}/api/v3/scanner/symbol/RELIANCE"
                    }
