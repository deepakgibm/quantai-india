{
    "info": {
        "name": "QuantAI India API Collection - With Tests",
        "description": "Complete API collection for QuantAI India with automated test scripts for stock price validation",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
        "_postman_id": "quantai-india-2026-tests"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:8000",
            "type": "string"
        },
        {
            "key": "token",
            "value": "",
            "type": "string"
        },
        {
            "key": "priceTolerance",
            "value": "0.5",
            "type": "string",
            "description": "Price tolerance in percent for validation"
        }
    ],
    "event": [
        {
            "listen": "prerequest",
            "script": {
                "type": "text/javascript",
                "exec": [
                    "// Global pre-request script",
                    "console.log('Testing: ' + pm.info.requestName);",
                    "pm.variables.set('startTime', Date.now());"
                ]
            }
        },
        {
            "listen": "test",
            "script": {
                "type": "text/javascript",
                "exec": [
                    "// Global test script - runs after every request",
                    "const responseTime = Date.now() - pm.variables.get('startTime');",
                    "",
                    "pm.test('Response time is acceptable (< 5000ms)', function() {",
                    "    pm.expect(responseTime).to.be.below(5000);",
                    "});",
                    "",
                    "pm.test('Response is JSON', function() {",
                    "    pm.response.to.be.json;",
                    "});"
                ]
            }
        }
    ],
    "item": [
